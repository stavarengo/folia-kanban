// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`structural visual-regression snapshots > a column header keeps its structural shape (.folia-column-header) 1`] = `"<header class="folia-column-header"><span class="folia-column-dot" aria-hidden="true"></span><span class="folia-column-title" title="Drag to reorder, click to rename" role="button" tabindex="0" aria-disabled="false" aria-roledescription="sortable">Todo</span><span class="folia-column-count" role="img" title="1 cards" aria-label="1 cards">1</span><span class="folia-host-slot"><div class="clickable-icon folia-column-menu-btn" tabindex="0" role="button" aria-haspopup="menu" aria-label="Column options for Todo" aria-disabled="false"><svg class="svg-icon lucide-ellipsis"></svg></div></span></header>"`;

exports[`structural visual-regression snapshots > a rendered card keeps its structural shape (.folia-card) 1`] = `"<div class="folia-card" data-testid="card" data-path="Tasks/Alpha.md" data-prio="prio-1"><div class="folia-card-main" role="button" tabindex="0" aria-disabled="false" aria-roledescription="sortable" aria-label="Alpha, 1 unread comment"><div class="folia-card-title">Alpha</div><div class="folia-chips"><span class="folia-chip folia-chip-prio-1" title="Priority">A</span><span class="folia-chip folia-chip-muted" title="Tag">home</span></div><div class="folia-progress" role="progressbar" aria-valuemin="0" aria-valuemax="2" aria-valuenow="1" title="1 of 2 subtasks done" aria-label="1 of 2 subtasks done"><span class="folia-host-slot folia-progress-slot"><div class="setting-progress-bar folia-progress-track"><div class="setting-progress-bar-inner" style="width: 50%;"></div></div></span><span class="folia-progress-label">1/2</span></div><div class="folia-card-meta"><span class="folia-comments-unread" title="1 comment, 1 unread comment" aria-label="1 comment, 1 unread comment"><svg class="folia-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg> 1<span class="folia-unread-dot" aria-hidden="true"></span></span></div></div><div class="folia-card-actions"><span class="folia-host-slot"><div class="clickable-icon folia-card-action folia-action-done" tabindex="0" role="button" aria-label="Mark &quot;Alpha&quot; done" aria-disabled="false"><svg class="svg-icon lucide-circle-check"></svg></div></span><span class="folia-host-slot"><div class="clickable-icon folia-card-action" tabindex="0" role="button" aria-label="Open note for &quot;Alpha&quot;" aria-disabled="false"><svg class="svg-icon lucide-external-link"></svg></div></span><span class="folia-host-slot"><div class="clickable-icon folia-card-action folia-action-delete" tabindex="0" role="button" aria-label="Delete &quot;Alpha&quot;" aria-disabled="false"><svg class="svg-icon lucide-trash-2"></svg></div></span></div></div>"`;

exports[`structural visual-regression snapshots > the detail header keeps its structural shape under an unbreakable title (.folia-detail-header) 1`] = `"<div class="folia-detail-header"><h2 class="folia-detail-title" title="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" tabindex="-1">xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx</h2><div class="folia-row-actions"><span class="folia-host-slot"><div class="clickable-icon folia-detail-icon folia-detail-action folia-action-done" tabindex="0" role="button" aria-label="Mark done" aria-disabled="false"><svg class="svg-icon lucide-circle-check"></svg></div></span><span class="folia-host-slot"><div class="clickable-icon folia-detail-icon folia-detail-action" tabindex="0" role="button" aria-label="Open note" aria-disabled="false"><svg class="svg-icon lucide-external-link"></svg></div></span><span class="folia-host-slot"><div class="clickable-icon folia-detail-icon folia-detail-action folia-action-delete" tabindex="0" role="button" aria-label="Delete card" aria-disabled="false"><svg class="svg-icon lucide-trash-2"></svg></div></span></div></div>"`;
