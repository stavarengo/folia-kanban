%%{init: {"flowchart": {"defaultRenderer": "elk", "curve": "basis", "nodeSpacing": 28, "rankSpacing": 60, "padding": 12}}}%%
flowchart LR
  subgraph S["Entry surfaces"]
    direction TB
    menu["Right-click menu<br/>tick · remove · move"]
    confirm["Tile 'Remove todo?' confirm"]
    panel["Detail panel row<br/>dropdown · checkbox · ×"]
    mcpDone["MCP set_subtask_done"]
    drag["Board drag · tile ✓ complete<br/>(placed todo): capture nothing"]
    mcpMove["MCP move_card<br/>(placed todo named by its path,<br/>Note.md#35;todo:1)"]
  end

  subgraph C["Reading the write is held to"]
    direction TB
    capOpen["SubItem read when it opened<br/>CardItem → readTodo()"]
    capPanel["SubItem from the panel's<br/>own readBody()"]
    capAgent["agent's index + text,<br/>checked against a fresh readBody()"]
    fallback["line? absent (opened on no todo)<br/>→ subtaskRef(board) at click"]
    idxOnly["index only: moveSubtask({ index })<br/>uses the line the board drew"]
  end

  subgraph L["Write layer"]
    direction TB
    app["App.tsx<br/>toggleTodo · moveTodo · removeTodo<br/>(…, line?: SubItem)"]
    mvCardTo["boardOps.ts moveCardTo<br/>→ board.ts moveCard"]
    sDone["boardOps.ts setSubtaskDone({ line })"]
    mvSub["board.ts moveSubtask({ index, line? })"]
  end

  subgraph V["vaultRepo.ts, inside Vault.process"]
    direction TB
    repoT["toggleSubtask(at) · removeSubtask(at)<br/>at = { index, text }"]
    repoM["applyMove<br/>setSubtaskStatus { index, text, claim }<br/>syncClaim { index, text }: claimInStep in-write"]
    guard{"editLine → card.ts subtaskDrift<br/>parseSubtasks[index].text === text<br/>(+ claim, when given)"}
  end

  refused["StaleLineError<br/>nothing written · toast / ToolError · reload"]
  ok["writes the line that was meant"]
  residue["identical line slid into that index<br/>text matches → lands on the wrong line"]
  shifted["index only: text and claim were taken<br/>from the line now at that index<br/>→ a shifted line is moved, no twin needed"]

  menu -->|opens| capOpen
  confirm -->|opens| capOpen
  menu -.-> fallback
  panel --> capPanel
  mcpDone --> capAgent
  drag --> idxOnly
  mcpMove -->|"fresh loadBoard()"| idxOnly
  capOpen --> app
  fallback -.-> app
  capPanel -->|dropdown| app
  capPanel -->|checkbox| sDone
  capPanel -->|× remove| repoT
  capAgent --> sDone
  idxOnly --> mvCardTo
  app -->|tick| sDone
  app -->|move| mvSub
  app -->|remove| repoT
  mvCardTo -->|no line| mvSub
  sDone --> repoT
  sDone -->|syncClaim| repoM
  mvSub --> repoM
  repoT --> guard
  repoM --> guard
  guard -->|drifted| refused
  guard -->|reads the same| ok
  guard -->|"reads the same,<br/>but it is a twin"| residue
  guard -->|"reads the same: board<br/>reloaded mid-drag"| shifted

  subgraph K["Legend"]
    direction TB
    k1["reading captured when the surface opened:<br/>survives a board reload"]
    k2["reading from the board snapshot at click / drop:<br/>as old as the last reload"]
    k3["silent wrong line: an identical twin,<br/>or an index-only write after a shift"]
    k4["refusal: intended behaviour"]
  end

  classDef green fill:#14331f,stroke:#4ade80,color:#e5e7eb
  classDef amber fill:#3d2e0c,stroke:#fbbf24,color:#e5e7eb
  classDef red fill:#461818,stroke:#f87171,color:#e5e7eb
  classDef blue fill:#152a45,stroke:#60a5fa,color:#e5e7eb
  classDef plain fill:#1f2430,stroke:#6b7280,color:#e5e7eb

  class menu,confirm,panel,mcpDone,capOpen,capPanel,capAgent,ok,k1 green
  class drag,mcpMove,idxOnly,fallback,k2 amber
  class residue,shifted,k3 red
  class refused,k4 blue
  class app,mvCardTo,sDone,mvSub,repoT,repoM,guard plain
  style S fill:#11151c,stroke:#30363d,color:#c9d1d9
  style C fill:#11151c,stroke:#30363d,color:#c9d1d9
  style L fill:#11151c,stroke:#30363d,color:#c9d1d9
  style V fill:#11151c,stroke:#30363d,color:#c9d1d9
  style K fill:#11151c,stroke:#30363d,color:#c9d1d9

  linkStyle 0,1,3,4,7,9,10,11,12,24 stroke:#4ade80,stroke-width:2px
  linkStyle 2,5,6,8,13,17 stroke:#fbbf24,stroke-width:2px
  linkStyle 14,15,16,18,19,20,21,22 stroke:#9ca3af,stroke-width:1.5px
  linkStyle 23 stroke:#60a5fa,stroke-width:2px
