{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": false,
    "requireBranch": "main",
    "requireUpstream": true,
    "requireCommits": true,
    "tagExclude": "*[-]*",
    "addUntrackedFiles": false,
    "commit": true,
    "commitMessage": "chore(release): ${version} :rocket:",
    "tag": true,
    "tagName": "${version}",
    "tagAnnotation": "Release ${version}",
    "push": true
  },
  "hooks": {
    "after:bump": "pnpm release:bump-plugin-version ${tagName}"
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false,
    "ignoreVersion": true,
    "allowSameVersion": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features"
          },
          {
            "type": "fix",
            "section": "Bug Fixes"
          },
          {
            "type": "revert",
            "section": "Reverts"
          },
          {
            "type": "perf",
            "section": "Performance"
          },
          {
            "type": "refactor",
            "section": "Refactoring"
          },
          {
            "type": "docs",
            "section": "Documentation"
          },
          {
            "type": "test",
            "section": "Tests"
          },
          {
            "type": "build",
            "section": "Build & Tooling"
          },
          {
            "type": "ci",
            "section": "Build & Tooling"
          },
          {
            "type": "style",
            "section": "Styling"
          },
          {
            "type": "chore",
            "effect": "hidden"
          }
        ]
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "ignoreRecommendedBump": true
    }
  }
}
