{
  "$description": "Corner radii.",
  "xs": {
    "$value": "var(--radius-s)",
    "cssVar": "--folia-r-xs",
    "source": {
      "alias": "--radius-s"
    }
  },
  "sm": {
    "$value": "var(--radius-s)",
    "cssVar": "--folia-r-sm",
    "source": {
      "alias": "--radius-s"
    }
  },
  "md": {
    "$value": "var(--radius-m)",
    "cssVar": "--folia-r",
    "source": {
      "alias": "--radius-m"
    }
  },
  "lg": {
    "$value": "var(--radius-l)",
    "cssVar": "--folia-r-lg",
    "source": {
      "alias": "--radius-l"
    }
  },
  "pill": {
    "$value": "999px",
    "cssVar": "--folia-r-pill",
    "source": {
      "owned": true,
      "reason": "a fully rounded end, which is a shape rather than a size, so no radius rung can express it."
    }
  },
  "nested-inset": {
    "$value": "2px",
    "cssVar": "--folia-r-nested-inset",
    "source": {
      "owned": true,
      "reason": "how far a nested surface's corner is tucked inside its parent's so the two curves stay concentric. It is arithmetic on a radius, answerable to the radius it is subtracted from rather than to the spacing grid, and Obsidian publishes no such offset.",
      "despite": "--size-2-1"
    }
  }
}
