{
  "$description": "Corner radii.",
  "sm": {
    "$value": "var(--radius-s)",
    "cssVar": "--folia-r-sm",
    "source": {
      "alias": "--radius-s"
    }
  },
  "md": {
    "$value": "var(--radius-m)",
    "cssVar": "--folia-r",
    "source": {
      "alias": "--radius-m"
    }
  },
  "lg": {
    "$value": "var(--radius-l)",
    "cssVar": "--folia-r-lg",
    "source": {
      "alias": "--radius-l"
    }
  },
  "pill": {
    "$value": "999px",
    "cssVar": "--folia-r-pill",
    "source": {
      "owned": true,
      "reason": "a fully rounded end, which is a shape rather than a size, so no radius rung can express it."
    }
  }
}
