{
  "$description": "The board's spacing rhythm: the space between things and inside them.",
  "hair": {
    "$value": "var(--size-2-1)",
    "cssVar": "--folia-space-hair",
    "source": {
      "alias": "--size-2-1"
    }
  },
  "xxs": {
    "$value": "var(--size-2-1)",
    "cssVar": "--folia-space-xxs",
    "source": {
      "alias": "--size-2-1"
    }
  },
  "xxs-plus": {
    "$value": "var(--size-4-1)",
    "cssVar": "--folia-space-xxs-plus",
    "source": {
      "alias": "--size-4-1"
    }
  },
  "xs": {
    "$value": "var(--size-4-1)",
    "cssVar": "--folia-space-xs",
    "source": {
      "alias": "--size-4-1"
    }
  },
  "xs-plus": {
    "$value": "var(--size-4-1)",
    "cssVar": "--folia-space-xs-plus",
    "source": {
      "alias": "--size-4-1"
    }
  },
  "sm": {
    "$value": "var(--size-2-3)",
    "cssVar": "--folia-space-sm",
    "source": {
      "alias": "--size-2-3"
    }
  },
  "sm-plus": {
    "$value": "var(--size-4-2)",
    "cssVar": "--folia-space-sm-plus",
    "source": {
      "alias": "--size-4-2"
    }
  },
  "md": {
    "$value": "var(--size-4-2)",
    "cssVar": "--folia-space-md",
    "source": {
      "alias": "--size-4-2"
    }
  },
  "md-plus": {
    "$value": "var(--size-4-2)",
    "cssVar": "--folia-space-md-plus",
    "source": {
      "alias": "--size-4-2"
    }
  },
  "gap": {
    "$value": "var(--size-4-2)",
    "cssVar": "--folia-gap",
    "source": {
      "alias": "--size-4-2"
    }
  },
  "pad": {
    "$value": "var(--size-4-3)",
    "cssVar": "--folia-pad",
    "source": {
      "alias": "--size-4-3"
    }
  },
  "lg": {
    "$value": "var(--size-4-3)",
    "cssVar": "--folia-space-lg",
    "source": {
      "alias": "--size-4-3"
    }
  },
  "xl": {
    "$value": "var(--size-4-4)",
    "cssVar": "--folia-space-xl",
    "source": {
      "alias": "--size-4-4"
    }
  },
  "xl-plus": {
    "$value": "var(--size-4-4)",
    "cssVar": "--folia-space-xl-plus",
    "source": {
      "alias": "--size-4-4"
    }
  },
  "xxl": {
    "$value": "var(--size-4-6)",
    "cssVar": "--folia-space-xxl",
    "source": {
      "alias": "--size-4-6"
    }
  },
  "bleed": {
    "$value": "calc(-1 * var(--size-2-3))",
    "cssVar": "--folia-space-bleed",
    "source": {
      "owned": true,
      "reason": "Negates the padding that the hover surface overlaps."
    }
  },
  "pull": {
    "$value": "calc(-1 * var(--size-4-1))",
    "cssVar": "--folia-space-pull",
    "source": {
      "owned": true,
      "reason": "Closes one host-grid step of the preceding block gap."
    }
  },
  "block": {
    "$value": "2em",
    "cssVar": "--folia-pad-block",
    "source": {
      "owned": true,
      "reason": "a full-pane state message is padded in its own text size, not in board pixels, so it stays proportionate when the user changes the font size."
    }
  },
  "notice-y": {
    "$value": "0.5em",
    "cssVar": "--folia-pad-notice-y",
    "source": {
      "owned": true,
      "reason": "a notice bar is padded in its own text size for the same reason as spacing.block."
    }
  },
  "para": {
    "$value": "0.25em",
    "cssVar": "--folia-space-para",
    "source": {
      "owned": true,
      "reason": "the space under a line of prose, sized in that prose's own text."
    }
  }
}
