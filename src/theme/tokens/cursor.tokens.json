{
  "$description": "The cursors the board puts on its own surfaces.",
  "control": {
    "$value": "var(--cursor)",
    "cssVar": "--folia-cursor-control",
    "source": {
      "alias": "--cursor"
    }
  },
  "inert": {
    "$value": "var(--cursor)",
    "cssVar": "--folia-cursor-inert",
    "source": {
      "alias": "--cursor"
    }
  },
  "grab": {
    "$value": "grab",
    "cssVar": "--folia-cursor-grab",
    "source": {
      "owned": true,
      "reason": "a card or column can be picked up; Obsidian has no draggable-board convention to follow."
    }
  },
  "grabbing": {
    "$value": "grabbing",
    "cssVar": "--folia-cursor-grabbing",
    "source": {
      "owned": true,
      "reason": "the same, while it is being dragged."
    }
  },
  "text": {
    "$value": "text",
    "cssVar": "--folia-cursor-text",
    "source": {
      "owned": true,
      "reason": "a block that turns into an editor when clicked."
    }
  },
  "help": {
    "$value": "help",
    "cssVar": "--folia-cursor-help",
    "source": {
      "owned": true,
      "reason": "a word that explains itself on hover."
    }
  },
  "resize": {
    "$value": "col-resize",
    "cssVar": "--folia-cursor-resize",
    "source": {
      "owned": true,
      "reason": "the detail panel's edge; Obsidian's own divider is a later phase (audit 02-17)."
    }
  },
  "link": {
    "$value": "var(--cursor-link)",
    "cssVar": "--folia-cursor-link",
    "source": {
      "alias": "--cursor-link"
    }
  }
}
