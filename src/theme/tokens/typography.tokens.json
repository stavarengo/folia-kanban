{
  "$description": "Font sizes, weights, line heights, tracking and the monospace stack.",
  "font-size": {
    "xxs": {
      "$value": "calc(var(--font-ui-smaller) * 5 / 6)",
      "cssVar": "--folia-font-size-xxs",
      "source": {
        "owned": true,
        "reason": "Compact badges use five sixths of the smallest host UI font, 10px at its 12px default, independently of layout spacing."
      }
    },
    "xs": {
      "$value": "calc(var(--font-ui-smaller) * 11 / 12)",
      "cssVar": "--folia-font-size-xs",
      "source": {
        "owned": true,
        "reason": "Secondary labels use eleven twelfths of the smallest host UI font, 11px at its 12px default, independently of layout spacing."
      }
    },
    "sm": {
      "$value": "var(--font-ui-smaller)",
      "cssVar": "--folia-font-size-sm",
      "source": {
        "alias": "--font-ui-smaller"
      }
    },
    "md": {
      "$value": "var(--font-ui-small)",
      "cssVar": "--folia-font-size-md",
      "source": {
        "alias": "--font-ui-small"
      }
    },
    "lg": {
      "$value": "var(--font-ui-medium)",
      "cssVar": "--folia-font-size-lg",
      "source": {
        "alias": "--font-ui-medium"
      }
    }
  },
  "font-mono": {
    "$value": "var(--font-monospace)",
    "cssVar": "--folia-font-mono",
    "source": {
      "alias": "--font-monospace"
    }
  },
  "weight": {
    "medium": {
      "$value": "var(--font-medium)",
      "cssVar": "--folia-font-weight-medium",
      "source": {
        "alias": "--font-medium"
      }
    },
    "semibold": {
      "$value": "var(--font-semibold)",
      "cssVar": "--folia-font-weight-semibold",
      "source": {
        "alias": "--font-semibold"
      }
    }
  },
  "line-height": {
    "normal": {
      "$value": "var(--line-height-normal)",
      "cssVar": "--folia-line-height",
      "source": {
        "alias": "--line-height-normal"
      }
    },
    "tight": {
      "$value": "var(--line-height-tight)",
      "cssVar": "--folia-line-height-tight",
      "source": {
        "alias": "--line-height-tight"
      }
    },
    "title": {
      "$value": "var(--line-height-tight)",
      "cssVar": "--folia-line-height-title",
      "source": {
        "alias": "--line-height-tight"
      }
    },
    "heading": {
      "$value": "var(--line-height-tight)",
      "cssVar": "--folia-line-height-heading",
      "source": {
        "alias": "--line-height-tight"
      }
    },
    "mark": {
      "$value": "1",
      "cssVar": "--folia-line-height-mark",
      "source": {
        "owned": true,
        "reason": "a glyph used as an icon, which must not add leading of its own."
      }
    }
  },
  "tracking": {
    "label": {
      "$value": "0.04em",
      "cssVar": "--folia-tracking-label",
      "source": {
        "owned": true,
        "reason": "the letter-spacing the board's uppercase micro-labels need to stay readable; Obsidian publishes no tracking."
      }
    },
    "key": {
      "$value": "0.03em",
      "cssVar": "--folia-tracking-key",
      "source": {
        "owned": true,
        "reason": "the same, a touch tighter, for the property keys and trace sources."
      }
    },
    "heading": {
      "$value": "0.05em",
      "cssVar": "--folia-tracking-heading",
      "source": {
        "owned": true,
        "reason": "the same, a touch wider, for a section heading."
      }
    }
  },
  "underline-offset": {
    "$value": "var(--size-2-1)",
    "cssVar": "--folia-underline-offset",
    "source": {
      "alias": "--size-2-1"
    }
  },
  "done-decoration": {
    "$value": "var(--checklist-done-decoration)",
    "cssVar": "--folia-done-decoration",
    "source": {
      "alias": "--checklist-done-decoration"
    }
  },
  "link-decoration": {
    "$value": "var(--link-decoration)",
    "cssVar": "--folia-link-decoration",
    "source": {
      "alias": "--link-decoration"
    }
  },
  "link-decoration-hover": {
    "$value": "var(--link-decoration-hover)",
    "cssVar": "--folia-link-decoration-hover",
    "source": {
      "alias": "--link-decoration-hover"
    }
  },
  "link-weight": {
    "$value": "var(--link-weight)",
    "cssVar": "--folia-link-weight",
    "source": {
      "alias": "--link-weight"
    }
  }
}
