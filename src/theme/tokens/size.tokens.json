{
  "$description": "The sizes the board's own furniture is cut to \u2014 widths, heights, hit targets and offsets.",
  "column-width": {
    "$value": "calc(var(--size-4-1) * 75)",
    "cssVar": "--folia-col-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "menu-width-min": {
    "$value": "calc(var(--size-4-1) * 50)",
    "cssVar": "--folia-menu-w-min",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "menu-width-max": {
    "$value": "calc(var(--size-4-1) * 80)",
    "cssVar": "--folia-menu-w-max",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "menu-width": {
    "$value": "calc(var(--size-4-1) * 56)",
    "cssVar": "--folia-menu-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "menu-height-max": {
    "$value": "calc(var(--size-4-1) * 110)",
    "cssVar": "--folia-menu-h-max",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "modal-width": {
    "$value": "calc(var(--size-4-1) * 110)",
    "cssVar": "--folia-modal-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "menu-padding": {
    "$value": "var(--size-4-3)",
    "cssVar": "--folia-menu-pad",
    "source": {
      "alias": "--size-4-3"
    }
  },
  "detail-width": {
    "$value": "calc(var(--size-4-1) * 95)",
    "cssVar": "--folia-detail-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "detail-modal-width": {
    "$value": "calc(var(--size-4-1) * 160)",
    "cssVar": "--folia-detail-modal-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "detail-modal-width-max": {
    "$value": "92vw",
    "cssVar": "--folia-detail-modal-w-max",
    "source": {
      "owned": true,
      "reason": "the share of the viewport the dialog may take on a narrow window; a viewport fraction is not something Obsidian names."
    }
  },
  "detail-modal-height-max": {
    "$value": "85vh",
    "cssVar": "--folia-detail-modal-h-max",
    "source": {
      "owned": true,
      "reason": "the share of the viewport height the dialog may take; a viewport fraction is not something Obsidian names."
    }
  },
  "detail-slide": {
    "$value": "var(--size-4-3)",
    "cssVar": "--folia-detail-slide",
    "source": {
      "alias": "--size-4-3"
    }
  },
  "suggest-height-max": {
    "$value": "calc(var(--size-4-1) * 70)",
    "cssVar": "--folia-suggest-h-max",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "search-width": {
    "$value": "calc(var(--size-4-1) * 80)",
    "cssVar": "--folia-search-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "add-column-width": {
    "$value": "calc(var(--size-4-1) * 55)",
    "cssVar": "--folia-add-column-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "prop-key-width": {
    "$value": "calc(var(--size-4-1) * 22)",
    "cssVar": "--folia-prop-key-w",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "card-title-clearance": {
    "$value": "calc(3 * var(--folia-hit-md) + 2 * var(--folia-space-hair) + 3 * var(--folia-space-xxs) + var(--folia-space-sm))",
    "cssVar": "--folia-card-title-pad-r",
    "source": {
      "owned": true,
      "reason": "Reserves three action buttons, two inter-button gaps, both container paddings, the right inset and one small breathing gap. It must grow with input-derived button widths so themed controls never cover a title."
    }
  },
  "card-overlay-inset": {
    "$value": "var(--size-4-4)",
    "cssVar": "--folia-card-overlay-inset",
    "source": {
      "alias": "--size-4-4"
    }
  },
  "description-height-min": {
    "$value": "var(--size-4-18)",
    "cssVar": "--folia-desc-h-min",
    "source": {
      "alias": "--size-4-18"
    }
  },
  "description-height-offset": {
    "$value": "calc(var(--size-4-1) * 55)",
    "cssVar": "--folia-desc-h-max-offset",
    "source": {
      "owned": true,
      "reason": "Board layout dimension expressed in host grid units; no single documented spacing rung spans this component."
    }
  },
  "comment-edit-height-min": {
    "$value": "var(--size-4-12)",
    "cssVar": "--folia-comment-edit-h-min",
    "source": {
      "alias": "--size-4-12"
    }
  },
  "column-body-height-min": {
    "$value": "var(--size-4-12)",
    "cssVar": "--folia-column-body-h-min",
    "source": {
      "alias": "--size-4-12"
    }
  },
  "viewport-height": {
    "$value": "100vh",
    "cssVar": "--folia-viewport-h",
    "source": {
      "owned": true,
      "reason": "the viewport itself, which nothing in a theme can name; the caps measured against it read it from here."
    }
  },
  "viewport-width": {
    "$value": "100vw",
    "cssVar": "--folia-viewport-w",
    "source": {
      "owned": true,
      "reason": "the viewport itself, which nothing in a theme can name; the caps measured against it read it from here."
    }
  },
  "column-park-margin": {
    "$value": "60vw",
    "cssVar": "--folia-col-park-margin",
    "source": {
      "owned": true,
      "reason": "how far a parked column slides out of the row, leaving a strip of it on screen; a product behaviour with no host equivalent."
    }
  },
  "toast-offset": {
    "$value": "var(--size-4-6)",
    "cssVar": "--folia-toast-bottom",
    "source": {
      "alias": "--size-4-6"
    }
  },
  "toast-rise": {
    "$value": "var(--size-4-3)",
    "cssVar": "--folia-toast-rise",
    "source": {
      "alias": "--size-4-3"
    }
  },
  "menu-rise": {
    "$value": "var(--size-4-1)",
    "cssVar": "--folia-menu-rise",
    "source": {
      "alias": "--size-4-1"
    }
  },
  "action-rise": {
    "$value": "var(--size-2-1)",
    "cssVar": "--folia-action-rise",
    "source": {
      "alias": "--size-2-1"
    }
  },
  "control-height": {
    "$value": "var(--input-height)",
    "cssVar": "--folia-control-h",
    "source": {
      "alias": "--input-height"
    }
  },
  "control-padding-x": {
    "$value": "var(--size-4-3)",
    "cssVar": "--folia-control-pad-x",
    "source": {
      "alias": "--size-4-3"
    }
  },
  "hit-small": {
    "$value": "calc(var(--input-height) - var(--size-4-2))",
    "cssVar": "--folia-hit-sm",
    "source": {
      "owned": true,
      "reason": "Mini actions stay two grid steps shorter than inputs to fit dense card and comment rows."
    }
  },
  "hit-medium": {
    "$value": "calc(var(--input-height) - var(--size-4-1))",
    "cssVar": "--folia-hit-md",
    "source": {
      "owned": true,
      "reason": "Icon buttons stay one grid step shorter than toolbar inputs, while following theme control height."
    }
  },
  "count-width-min": {
    "$value": "var(--size-4-5)",
    "cssVar": "--folia-count-w-min",
    "source": {
      "alias": "--size-4-5"
    }
  },
  "column-dot": {
    "$value": "var(--size-4-2)",
    "cssVar": "--folia-dot",
    "source": {
      "alias": "--size-4-2"
    }
  },
  "unread-dot": {
    "$value": "var(--size-2-3)",
    "cssVar": "--folia-unread-dot",
    "source": {
      "alias": "--size-2-3"
    }
  },
  "todo-mark": {
    "$value": "var(--size-4-2)",
    "cssVar": "--folia-todo-mark",
    "source": {
      "alias": "--size-4-2"
    }
  },
  "progress-height": {
    "$value": "var(--size-4-1)",
    "cssVar": "--folia-progress-h",
    "source": {
      "alias": "--size-4-1"
    }
  },
  "divider-height": {
    "$value": "var(--border-width)",
    "cssVar": "--folia-divider-h",
    "source": {
      "alias": "--border-width"
    }
  },
  "resize-handle-width": {
    "$value": "var(--size-2-3)",
    "cssVar": "--folia-resize-w",
    "source": {
      "alias": "--size-2-3"
    }
  },
  "resize-handle-offset": {
    "$value": "calc(var(--folia-resize-w) / -2)",
    "cssVar": "--folia-resize-offset",
    "source": {
      "owned": true,
      "reason": "Centers the resize target on the panel edge."
    }
  },
  "icon-baseline": {
    "$value": "-0.15em",
    "cssVar": "--folia-icon-baseline",
    "source": {
      "owned": true,
      "reason": "how far an inline icon drops below the text baseline, measured in that text; a typographic correction Obsidian does not publish."
    }
  },
  "ctx-strip-inset": {
    "$value": "var(--size-2-3)",
    "cssVar": "--folia-ctx-strip-inset",
    "source": {
      "alias": "--size-2-3"
    }
  }
}
