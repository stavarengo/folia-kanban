{
  "$description": "Semantic colours, the priority ramp and the column product palette.",
  "border": {
    "$value": "var(--background-modifier-border)",
    "cssVar": "--folia-border",
    "source": {
      "alias": "--background-modifier-border"
    }
  },
  "border-strong": {
    "$value": "var(--background-modifier-border-hover, var(--background-modifier-border))",
    "cssVar": "--folia-border-strong",
    "source": {
      "alias": "--background-modifier-border-hover",
      "fallback": {
        "value": "var(--background-modifier-border)",
        "reason": "Obsidian's base border behind its hover border, so a theme that defines only one still draws a line. The fallback is a second variable rather than a literal: it keeps the board on the theme either way."
      }
    }
  },
  "card-bg": {
    "$value": "var(--background-primary)",
    "cssVar": "--folia-card-bg",
    "source": {
      "alias": "--background-primary"
    }
  },
  "column-bg": {
    "$value": "var(--background-secondary)",
    "cssVar": "--folia-col-bg",
    "source": {
      "alias": "--background-secondary"
    }
  },
  "column-header-bg": {
    "$value": "var(--background-secondary-alt)",
    "cssVar": "--folia-col-header-bg",
    "source": {
      "alias": "--background-secondary-alt"
    }
  },
  "drop-target-bg": {
    "$value": "var(--background-modifier-active-hover)",
    "cssVar": "--folia-drop-target-bg",
    "source": {
      "alias": "--background-modifier-active-hover"
    }
  },
  "field-bg": {
    "$value": "var(--background-modifier-form-field)",
    "cssVar": "--folia-field-bg",
    "source": {
      "alias": "--background-modifier-form-field"
    }
  },
  "priority": {
    "1": {
      "$value": "var(--color-red)",
      "cssVar": "--folia-prio-1",
      "source": {
        "alias": "--color-red"
      }
    },
    "2": {
      "$value": "var(--color-orange)",
      "cssVar": "--folia-prio-2",
      "source": {
        "alias": "--color-orange"
      }
    },
    "3": {
      "$value": "var(--color-yellow)",
      "cssVar": "--folia-prio-3",
      "source": {
        "alias": "--color-yellow"
      }
    },
    "4": {
      "$value": "var(--color-blue)",
      "cssVar": "--folia-prio-4",
      "source": {
        "alias": "--color-blue"
      }
    }
  },
  "accent": {
    "$value": "var(--interactive-accent)",
    "cssVar": "--folia-accent",
    "source": {
      "alias": "--interactive-accent"
    }
  },
  "text-accent": {
    "$value": "var(--text-accent)",
    "cssVar": "--folia-text-accent",
    "source": {
      "alias": "--text-accent"
    }
  },
  "text-accent-hover": {
    "$value": "var(--text-accent-hover)",
    "cssVar": "--folia-text-accent-hover",
    "source": {
      "alias": "--text-accent-hover"
    }
  },
  "danger": {
    "$value": "var(--color-red)",
    "cssVar": "--folia-danger",
    "source": {
      "alias": "--color-red"
    }
  },
  "text-error": {
    "$value": "var(--text-error)",
    "cssVar": "--folia-text-error",
    "source": {
      "alias": "--text-error"
    }
  },
  "text-warning": {
    "$value": "var(--text-warning)",
    "cssVar": "--folia-text-warning",
    "source": {
      "alias": "--text-warning"
    }
  },
  "text-success": {
    "$value": "var(--text-success)",
    "cssVar": "--folia-text-success",
    "source": {
      "alias": "--text-success"
    }
  },
  "unread": {
    "$value": "var(--color-blue)",
    "cssVar": "--folia-unread",
    "source": {
      "alias": "--color-blue"
    }
  },
  "unread-reply": {
    "$value": "var(--color-purple)",
    "cssVar": "--folia-unread-reply",
    "source": {
      "alias": "--color-purple"
    }
  },
  "done-color": {
    "$value": "var(--checklist-done-color)",
    "cssVar": "--folia-done-color",
    "source": {
      "alias": "--checklist-done-color"
    }
  },
  "link-color": {
    "$value": "color-mix(in srgb, var(--link-color) 75%, var(--text-normal))",
    "cssVar": "--folia-link-color",
    "source": {
      "owned": true,
      "reason": "Obsidian's default light link colour is 4.26:1 on white, under WCAG AA on every surface; mixed toward --text-normal it keeps the theme's hue and passes (measured live 2026-09-29, docs/decisions.md)."
    }
  },
  "link-color-hover": {
    "$value": "color-mix(in srgb, var(--link-color-hover) 55%, var(--text-normal))",
    "cssVar": "--folia-link-color-hover",
    "source": {
      "owned": true,
      "reason": "Obsidian's default light link hover is a lighter accent, 3.8:1 even at the rest colour's 75%; at 55% it measured 5.4:1 in light and 9.1:1 in dark (2026-09-29, docs/decisions.md)."
    }
  },
  "link-unresolved-color": {
    "$value": "color-mix(in srgb, var(--link-unresolved-color) 50%, var(--text-muted))",
    "cssVar": "--folia-link-unresolved-color",
    "source": {
      "owned": true,
      "reason": "Obsidian dims an unresolved link to 0.7 of its accent, 2.7:1 on the detail dialog in light; half the accent in --text-muted keeps it quieter than a resolved link and readable (measured 2026-09-29, docs/decisions.md)."
    }
  },
  "link-unresolved-decoration-color": {
    "$value": "var(--link-unresolved-decoration-color)",
    "cssVar": "--folia-link-unresolved-decoration-color",
    "source": {
      "alias": "--link-unresolved-decoration-color"
    }
  },
  "column": {
    "1": {
      "$value": "blue"
    },
    "2": {
      "$value": "green"
    },
    "3": {
      "$value": "orange"
    },
    "4": {
      "$value": "purple"
    },
    "5": {
      "$value": "red"
    },
    "6": {
      "$value": "cyan"
    },
    "7": {
      "$value": "pink"
    },
    "8": {
      "$value": "yellow"
    },
    "$description": "The colours a column can take: the NAME of one of Obsidian's eight extended colours, stored in the board note and resolved to var(--color-<name>) at render time, so a column accent follows the theme and its light/dark pair. src/ui/columnColors.ts is the single source of truth and this mirrors it, in its order."
  }
}
