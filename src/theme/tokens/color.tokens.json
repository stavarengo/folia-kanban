{
  "$description": "Semantic colours, the priority ramp and the column product palette.",
  "border": {
    "$value": "var(--background-modifier-border)",
    "cssVar": "--folia-border",
    "source": {
      "alias": "--background-modifier-border"
    }
  },
  "border-strong": {
    "$value": "var(--background-modifier-border-hover, var(--background-modifier-border))",
    "cssVar": "--folia-border-strong",
    "source": {
      "alias": "--background-modifier-border-hover",
      "fallback": {
        "value": "var(--background-modifier-border)",
        "reason": "Obsidian's base border behind its hover border, so a theme that defines only one still draws a line. The fallback is a second variable rather than a literal: it keeps the board on the theme either way."
      }
    }
  },
  "card-bg": {
    "$value": "var(--background-primary)",
    "cssVar": "--folia-card-bg",
    "source": {
      "alias": "--background-primary"
    }
  },
  "column-bg": {
    "$value": "var(--background-secondary)",
    "cssVar": "--folia-col-bg",
    "source": {
      "alias": "--background-secondary"
    }
  },
  "column-header-bg": {
    "$value": "var(--background-secondary-alt)",
    "cssVar": "--folia-col-header-bg",
    "source": {
      "alias": "--background-secondary-alt"
    }
  },
  "drop-target-bg": {
    "$value": "var(--background-modifier-active-hover)",
    "cssVar": "--folia-drop-target-bg",
    "source": {
      "alias": "--background-modifier-active-hover"
    }
  },
  "field-bg": {
    "$value": "var(--background-modifier-form-field)",
    "cssVar": "--folia-field-bg",
    "source": {
      "alias": "--background-modifier-form-field"
    }
  },
  "scrim": {
    "$value": "rgba(0, 0, 0, 0.45)",
    "cssVar": "--folia-scrim",
    "source": {
      "owned": true,
      "reason": "the dimming behind a dialog; Obsidian's modal background is a later phase (audit 02-34)."
    },
    "themes": {
      "light": {
        "$value": "rgba(0, 0, 0, 0.34)",
        "source": {
          "owned": true,
          "reason": "Lighter than the dark scheme's 0.45, but still enough that the board reads as sent behind the dialog. An earlier 0.2 was chosen for subtlety and left the columns fully saturated, so nothing separated a dialog from the board under it; live comparison on Moonstone put the turn at roughly a third. Obsidian's own .modal-bg uses --background-modifier-cover, a light-grey veil rather than a black one, which on this board washes towards grey without sending anything back; adopting that variable is audit 02-34's call, not a value choice."
        }
      }
    }
  },
  "priority": {
    "1": {
      "$value": "var(--color-red)",
      "cssVar": "--folia-prio-1",
      "source": {
        "alias": "--color-red"
      }
    },
    "2": {
